<%
  readonly = @issue.status.is_closed?
  can_add = User.current.allowed_to?(:add_line_items, nil, global: true)
  can_edit = User.current.allowed_to?(:edit_line_items, nil, global: true)
  can_delete = User.current.allowed_to?(:delete_line_items, nil, global: true)
  permissions = { can_edit: can_edit, can_delete: can_delete }
%>

<% @issue.line_items.build if @issue.line_items.empty? && !readonly && can_add %>

<%# Styled like redmine_qbo's estimate and invoice editor (see line_items.css) %>
<div class="box line-items-sheet"
     data-nested-form
     data-wrapper-selector=".line-item">

  <span class="line-items-title"><%= t :label_line_items %></span>

  <div class="line-items-wrap">
    <table class="line-items-table line-items-editor">
      <thead>
        <tr>
          <th class="line-item-number">#</th>
          <th class="line-item-description-cell"><%= t :label_description %></th>
          <th class="line-item-qty"><%= t :label_qty %></th>
          <th class="line-item-price"><%= t :label_price %></th>
          <th class="line-item-total"><%= t :label_total %></th>
          <% unless readonly %>
            <th class="actions"></th>
          <% end %>
        </tr>
      </thead>

      <tbody data-nested-form-container>
        <%= f.fields_for :line_items do |item_form| %>
          <%= render "line_items/line_item_fields",
                f: item_form,
                readonly: readonly,
                **permissions %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="line-items-bottom">
    <% if !readonly && can_add %>
      <template data-nested-form-template>
        <%= f.fields_for :line_items, LineItem.new, child_index: "NEW_RECORD" do |item_form| %>
          <%= render "line_items/line_item_fields",
                f: item_form,
                readonly: false,
                **permissions %>
        <% end %>
      </template>

      <p class="line-items-buttons">
        <button type="button"
                class="line-items-button"
                data-nested-form-add>
          <%= l(:button_add) %>
        </button>
      </p>
    <% end %>

    <table class="line-items-totals">
      <tr class="line-items-grand-total">
        <th><%= t :label_total %></th>
        <td id="line-items-grand-total">0.00</td>
      </tr>
    </table>
  </div>

</div>
