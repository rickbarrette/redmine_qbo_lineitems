<%
  item = f.object
  billed = item.persisted? && item.billed?
  # Billed lines are on a QuickBooks estimate already; existing lines need "Edit line items" to change
  locked = readonly || billed || (item.persisted? && !can_edit)
  # Unsaved rows can always be removed; saved ones need "Delete line items"
  removable = !readonly && !billed && (item.new_record? || can_delete)
%>
<tr class="line-item<%= ' billed' if billed %>">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy %>
  <%= f.hidden_field :item_id, class: "item-id-field" %>

  <%# Numbered by a CSS counter, so removed (hidden) rows are skipped %>
  <td class="line-item-number"></td>

  <td class="line-item-description-cell" data-label="<%= t :label_description %>">
    <% if billed %>
      <span class="line-item-billed-badge" title="<%= l(:text_line_item_billed) %>"><%= l(:label_billed) %></span>
    <% end %>
    <%= f.text_field :description,
          placeholder: l(:label_description),
          class: "line-item-description",
          autocomplete: "off",
          no_label: true,
          disabled: locked %>
  </td>

  <td class="line-item-qty" data-label="<%= t :label_qty %>">
    <%# Fractional quantities are allowed (e.g. 0.5 hours, 2.5 quarts) %>
    <%= f.number_field :quantity,
          step: "any",
          min: 0,
          value: (item.quantity.to_f > 0) ? number_with_precision(item.quantity, precision: 4, strip_insignificant_zeros: true) : 1,
          class: "qty-field",
          no_label: true,
          disabled: locked %>
  </td>

  <td class="line-item-price" data-label="<%= t :label_price %>">
    <%= f.text_field :unit_price,
          value: (number_with_precision(item.unit_price, precision: 2) unless item.unit_price.nil?),
          class: "price-field",
          inputmode: "decimal",
          autocomplete: "off",
          no_label: true,
          disabled: locked %>
  </td>

  <td class="line-item-total line-total" data-label="<%= t :label_total %>">
    0.00
  </td>

  <% unless readonly %>
    <td class="actions">
      <% if removable %>
        <button type="button"
                class="line-item-remove-button"
                title="<%= l(:label_remove) %>"
                aria-label="<%= l(:label_remove) %>"
                data-nested-form-remove><%= sprite_icon('del') %></button>
      <% end %>
    </td>
  <% end %>
</tr>
